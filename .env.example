# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public — used to build absolute share URLs
# On Vercel, set this to your production URL (e.g. https://your-app.vercel.app)
# If omitted, VERCEL_URL is used automatically at runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Admin — your email is the only account that can open /orbit-control
ORBIT_ADMIN_EMAIL=

# --- Vercel deployment checklist ---
# 1. Push this repo to GitHub (do NOT upload node_modules or .next)
# 2. Import the repo in vercel.com → Add New Project
# 3. Framework Preset: Next.js | Root Directory: . (repo root)
# 4. Add the variables above in Vercel → Settings → Environment Variables
#    (Production + Preview + Development)
# 5. In Supabase → Authentication → URL Configuration, add:
#    - Site URL: https://your-app.vercel.app
#    - Redirect URLs: https://your-app.vercel.app/auth/callback
