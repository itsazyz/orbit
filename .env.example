# Public — safe to expose to the browser (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public — canonical origin used for share links, OG images and the sitemap.
# On Vercel, leave empty to use the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No service-role key is needed. Admin rights live in Postgres:
#   insert into private.admins (email) values ('you@example.com');
