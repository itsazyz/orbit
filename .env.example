# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public — used to build absolute share URLs (e.g. https://orbit.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Used only in server actions / route handlers that must bypass RLS
# (e.g. account deletion). Do not use this for normal reads/writes.
SUPABASE_SERVICE_ROLE_KEY=
